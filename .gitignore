# uv / venv
.venv/
__pycache__/
*.py[cod]

# MLflow runtime
mlruns/
mlartifacts/
mlflow.db
mlflow.db-journal

# Data — raw CSV is checked in (tutorial dataset, ~700KB) so `git clone` is
# enough to run the demo. Processed splits are deterministic from the raw via
# data.preprocess + data.get_splits, so they're regenerated by seed_runs.
data/raw/*
!data/raw/.gitkeep
!data/raw/Churn_Modelling.csv
data/processed/*
!data/processed/.gitkeep

# IDE
.vscode/
.idea/
.DS_Store

# Claude Code session-local state (per-user permissions, settings)
.claude/
