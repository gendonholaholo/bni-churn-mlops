# Copy to .env and adjust values for your local setup.
#   cp .env.example .env
#
# config.py auto-loads this via python-dotenv. Variables already set in your
# shell take precedence over .env values.

# ---- MLflow ----
# Tracking server. Use the local Docker container, a remote MLflow, or fall
# back to file-based SQLite by leaving this unset.
MLFLOW_TRACKING_URI=http://localhost:5001

# Override the UI link shown in Gradio + CLI prints. Defaults to the value of
# MLFLOW_TRACKING_URI when it's HTTP, otherwise http://localhost:5001.
# MLFLOW_UI_URL=http://localhost:5001
